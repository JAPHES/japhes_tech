DJANGO_SETTINGS_MODULE=japhestech.settings
SECRET_KEY='replace-with-a-long-random-secret'
DEBUG=False

# The EC2 public IP is included for direct HTTP testing before the DNS switch.
ALLOWED_HOSTS=japhes.secora.dev,13.48.27.36
CSRF_TRUSTED_ORIGINS=https://japhes.secora.dev,http://13.48.27.36
CANONICAL_HOST=japhes.secora.dev

# Keep these False until the HTTPS certificate is installed and verified.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Gunicorn is bound to localhost by systemd; Nginx is the public entry point.
USE_X_FORWARDED_HOST=True
